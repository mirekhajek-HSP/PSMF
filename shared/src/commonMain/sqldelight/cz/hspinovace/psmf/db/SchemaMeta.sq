-- Schema version marker.
--
-- Phase 1 wiring only: this table exists so that the SQLDelight plugin,
-- the generated database and the per-platform drivers are all proven to
-- work before any domain table is designed. The domain schema lands in
-- Phase 2 alongside the model it persists.

CREATE TABLE schema_meta (
    id          INTEGER NOT NULL PRIMARY KEY,
    version     INTEGER NOT NULL,
    applied_at  TEXT    NOT NULL
);

selectVersion:
SELECT version FROM schema_meta WHERE id = 1;

upsertVersion:
INSERT OR REPLACE INTO schema_meta (id, version, applied_at)
VALUES (1, ?, ?);
